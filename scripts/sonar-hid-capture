#!/usr/bin/env python3
"""Kulaklığın HID raporlarını kaydeder — ChatMix tekerinin biçimini çözmek için.

Kullanım:

    ./scripts/sonar-hid-capture            # bulunan tüm SteelSeries düğümlerini dinler
    ./scripts/sonar-hid-capture /dev/hidraw0

Teker uçtan uca çevrilirken çalıştırın. Her rapor bir satır olarak basılır; hangi
baytın nasıl değiştiği böyle görünür. Çıktı `tests/data/` altına konup çözücü testi
onunla yazılır.

Cihaza **hiçbir şey yazmaz**; yalnızca okur.
"""

from __future__ import annotations

import os
import select
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from sonar.engine.headset import detect_headsets  # noqa: E402


def main(argv: list[str]) -> int:
    paths = argv[1:] or [h.device for h in detect_headsets()]
    if not paths:
        print("Bilinen bir kulaklık bulunamadı.", file=sys.stderr)
        return 1

    handles: dict[int, str] = {}
    for path in paths:
        try:
            handles[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
        except OSError as error:
            print(f"{path}: açılamadı ({error.strerror}).", file=sys.stderr)
            if error.errno == 13:  # EACCES
                print(
                    "  udev kuralı gerekiyor:\n"
                    "    sudo cp packaging/99-sonar-headset.rules /etc/udev/rules.d/\n"
                    "    sudo udevadm control --reload && sudo udevadm trigger",
                    file=sys.stderr,
                )
    if not handles:
        return 1

    print(f"Dinleniyor: {', '.join(handles.values())}")
    print("Tekeri yavaşça uçtan uca çevirin. Bitirmek için Ctrl+C.\n")
    started = time.monotonic()
    try:
        while True:
            ready, _, _ = select.select(list(handles), [], [], 1.0)
            for fd in ready:
                data = os.read(fd, 64)
                if not data:
                    continue
                stamp = time.monotonic() - started
                hexed = " ".join(f"{b:02x}" for b in data)
                print(f"{stamp:7.3f}  {handles[fd]:<14} {len(data):2d}B  {hexed}")
    except KeyboardInterrupt:
        print("\nBitti.")
    finally:
        for fd in handles:
            os.close(fd)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
