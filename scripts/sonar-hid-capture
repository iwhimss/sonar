#!/usr/bin/env python3
"""Kulaklığın HID raporlarını kaydeder — ChatMix tekerinin biçimini çözmek için.

Kullanım:

    ./scripts/sonar-hid-capture            # bulunan tüm SteelSeries düğümlerini dinler
    ./scripts/sonar-hid-capture /dev/hidraw0

Teker uçtan uca çevrilirken çalıştırın. Her rapor bir satır olarak basılır; hangi
baytın nasıl değiştiği böyle görünür. Çıktı `tests/data/` altına konup çözücü testi
onunla yazılır.

Cihaza **hiçbir şey yazmaz**; yalnızca okur.
"""

from __future__ import annotations

import os
import select
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from sonar.engine.headset import UDEV_RULE_NAME, detect_headsets


def _explain_permissions() -> None:
    """Erişim reddedildiğinde ne yapılacağını söyler — kurulu kuralı da kontrol ederek."""
    rules = Path("/etc/udev/rules.d")
    installed = rules / UDEV_RULE_NAME
    stale = rules / "99-sonar-headset.rules"

    print("  udev kuralı gerekiyor:", file=sys.stderr)
    print(f"    sudo cp packaging/{UDEV_RULE_NAME} /etc/udev/rules.d/", file=sys.stderr)
    if stale.exists():
        print(
            "    sudo rm /etc/udev/rules.d/99-sonar-headset.rules"
            "   # eski kopya; 99 çok geç çalışıyor",
            file=sys.stderr,
        )
    print("    sudo udevadm control --reload && sudo udevadm trigger", file=sys.stderr)
    if installed.exists():
        print(
            f"\n  Not: {installed} zaten kurulu ama erişim yok. Kulaklığı çıkarıp\n"
            "  takmak veya oturumu yeniden açmak gerekebilir — ACL cihaz eklendiğinde\n"
            "  uygulanıyor.",
            file=sys.stderr,
        )


def main(argv: list[str]) -> int:
    paths = argv[1:] or [h.device for h in detect_headsets()]
    if not paths:
        print("Bilinen bir kulaklık bulunamadı.", file=sys.stderr)
        return 1

    handles: dict[int, str] = {}
    for path in paths:
        try:
            handles[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
        except OSError as error:
            print(f"{path}: açılamadı ({error.strerror}).", file=sys.stderr)
            if error.errno == 13:  # EACCES
                _explain_permissions()
    if not handles:
        return 1

    print(f"Dinleniyor: {', '.join(handles.values())}")
    print("Tekeri yavaşça uçtan uca çevirin. Bitirmek için Ctrl+C.\n")
    started = time.monotonic()
    try:
        while True:
            ready, _, _ = select.select(list(handles), [], [], 1.0)
            for fd in ready:
                data = os.read(fd, 64)
                if not data:
                    continue
                stamp = time.monotonic() - started
                hexed = " ".join(f"{b:02x}" for b in data)
                print(f"{stamp:7.3f}  {handles[fd]:<14} {len(data):2d}B  {hexed}")
    except KeyboardInterrupt:
        print("\nBitti.")
    finally:
        for fd in handles:
            os.close(fd)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
