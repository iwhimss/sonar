        args = {
            node.description = "Sonar Game → personal"
            audio.position = [ "FL" "FR" ]
            capture.props = {
                node.name = "sonar_game_to_personal_capture"
                node.passive = true
                target.object = "sonar_game_fx"
                stream.capture.sink = false
                audio.rate = 48000
                audio.channels = 2
                audio.position = [ "FL" "FR" ]
