                    }
                    {
                        type = "lv2"
                        name = "lim"
                        plugin = "http://lsp-plug.in/plugins/lv2/limiter_stereo"
                        control = {
                            enabled = 0.0
                        }
                    }
                ]
                inputs = [ "df:Audio In L" "df:Audio In R" ]
                outputs = [ "lim:out_l" "lim:out_r" ]
                links = [
                    {
                        output = "df:Audio Out L"
                        input = "gate:in_l"
                    }
                    {
                        output = "df:Audio Out R"
                        input = "gate:in_r"
                    }
                    {
                        output = "gate:out_l"
                        input = "eq:in_l"
                    }
                    {
                        output = "gate:out_r"
                        input = "eq:in_r"
                    }
                    {
                        output = "eq:out_l"
                        input = "comp:in_l"
                    }
                    {
                        output = "eq:out_r"
                        input = "comp:in_r"
                    }
                    {
                        output = "comp:out_l"
                        input = "spatial_copy_l:In"
                    }
                    {
                        output = "comp:out_r"
                        input = "spatial_copy_r:In"
                    }
                    {
                        output = "spatial_copy_l:Out"
                        input = "spatial_mix_l:In 1"
                    }
                    {
                        output = "spatial_copy_r:Out"
                        input = "spatial_mix_r:In 1"
                    }
                    {
                        output = "spatial_copy_l:Out"
                        input = "spatial_delay_l:In"
                    }
                    {
                        output = "spatial_copy_r:Out"
                        input = "spatial_delay_r:In"
                    }
                    {
