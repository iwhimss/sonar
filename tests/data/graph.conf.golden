    {
        name = "libpipewire-module-filter-chain"
        args = {
            node.description = "Sonar Mic"
            media.name = "Sonar Mic"
            filter.graph = {
                nodes = [
                    {
                        type = "ladspa"
                        name = "df"
                        plugin = "libdeep_filter_ladspa.so"
                        label = "deep_filter_stereo"
                        control = {
                            "Attenuation Limit (dB)" = 0.0
                        }
                    }
                    {
                        type = "lv2"
                        name = "gate"
                        plugin = "http://lsp-plug.in/plugins/lv2/gate_stereo"
                        control = {
                            enabled = 0.0
                        }
                    }
                    {
                        type = "lv2"
                        name = "eq"
                        plugin = "http://lsp-plug.in/plugins/lv2/para_equalizer_x16_stereo"
                        control = {
                            enabled = 0.0
                            ife_l = 0.0
                            ife_r = 0.0
                            ofe_l = 0.0
                            ofe_r = 0.0
                            rfe_l = 0.0
                            rfe_r = 0.0
                        }
                    }
                    {
                        type = "lv2"
                        name = "comp"
                        plugin = "http://lsp-plug.in/plugins/lv2/compressor_stereo"
                        control = {
                            enabled = 0.0
                        }
                    }
                    {
                        type = "lv2"
                        name = "lim"
                        plugin = "http://lsp-plug.in/plugins/lv2/limiter_stereo"
                        control = {
                            enabled = 0.0
                        }
                    }
                ]
                inputs = [ "df:Audio In L" "df:Audio In R" ]
                outputs = [ "lim:out_l" "lim:out_r" ]
                links = [
                    {
                        output = "df:Audio Out L"
                        input = "gate:in_l"
                    }
                    {
                        output = "df:Audio Out R"
                        input = "gate:in_r"
                    }
                    {
                        output = "gate:out_l"
                        input = "eq:in_l"
                    }
                    {
                        output = "gate:out_r"
                        input = "eq:in_r"
                    }
                    {
                        output = "eq:out_l"
                        input = "comp:in_l"
                    }
                    {
