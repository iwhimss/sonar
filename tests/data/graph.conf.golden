                        input = "spatial_lp_l:In"
                    }
                    {
                        output = "spatial_delay_r:Out"
                        input = "spatial_lp_r:In"
                    }
                    {
                        output = "spatial_lp_l:Out"
                        input = "spatial_mix_r:In 2"
                    }
                    {
                        output = "spatial_lp_r:Out"
                        input = "spatial_mix_l:In 2"
                    }
                    {
                        output = "spatial_mix_l:Out"
                        input = "boost_l:In"
                    }
                    {
                        output = "spatial_mix_r:Out"
                        input = "boost_r:In"
                    }
                    {
