    {
        name = "libpipewire-module-filter-chain"
        args = {
            node.description = "Sonar Stream Mic"
            media.name = "Sonar Stream Mic"
            filter.graph = {
                nodes = [
                    {
                        type = "ladspa"
                        name = "df"
                        plugin = "libdeep_filter_ladspa.so"
