                    }
                ]
            }
            capture.props = {
                node.name = "sonar_chat"
                node.description = "Sonar Chat — Virtual Output"
                node.nick = "Chat"
                media.class = "Audio/Sink"
                device.icon-name = "audio-card"
                priority.session = 0
                audio.rate = 48000
                audio.channels = 2
                audio.position = [ "FL" "FR" ]
            }
            playback.props = {
                node.name = "sonar_chat_fx"
                node.autoconnect = false
                audio.rate = 48000
                audio.channels = 2
                audio.position = [ "FL" "FR" ]
                node.description = "Sonar Chat FX"
            }
        }
    }
