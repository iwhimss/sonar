                        label = "delay"
                        control = {
                            "Delay (s)" = 0.0
                        }
                        config = {
                            max-delay = 0.01
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_delay_r"
                        label = "delay"
                        control = {
                            "Delay (s)" = 0.0
                        }
                        config = {
                            max-delay = 0.01
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_lp_l"
                        label = "bq_lowpass"
                        control = {
                            Freq = 1000.0
                            Q = 0.707
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_lp_r"
                        label = "bq_lowpass"
                        control = {
                            Freq = 1000.0
                            Q = 0.707
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_mix_l"
                        label = "mixer"
                        control = {
                            "Gain 1" = 1.0
                            "Gain 2" = 0.0
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_mix_r"
                        label = "mixer"
                        control = {
                            "Gain 1" = 1.0
                            "Gain 2" = 0.0
                        }
                    }
                    {
                        type = "builtin"
                        name = "boost_l"
                        label = "linear"
                        control = {
                            Mult = 1.0
                            Add = 0.0
                        }
                    }
                    {
                        type = "builtin"
                        name = "boost_r"
                        label = "linear"
                        control = {
                            Mult = 1.0
                            Add = 0.0
                        }
                    }
                    {
                        type = "lv2"
                        name = "lim"
                        plugin = "http://lsp-plug.in/plugins/lv2/limiter_stereo"
                        control = {
                            enabled = 0.0
                        }
                    }
                ]
                inputs = [ "gate:in_l" "gate:in_r" ]
                outputs = [ "lim:out_l" "lim:out_r" ]
                links = [
                    {
                        output = "gate:out_l"
                        input = "eq:in_l"
                    }
                    {
                        output = "gate:out_r"
                        input = "eq:in_r"
                    }
                    {
                        output = "eq:out_l"
                        input = "comp:in_l"
                    }
                    {
                        output = "eq:out_r"
                        input = "comp:in_r"
                    }
                    {
                        output = "comp:out_l"
                        input = "spatial_copy_l:In"
                    }
                    {
                        output = "comp:out_r"
                        input = "spatial_copy_r:In"
                    }
                    {
                        output = "spatial_copy_l:Out"
                        input = "spatial_mix_l:In 1"
                    }
                    {
                        output = "spatial_copy_r:Out"
                        input = "spatial_mix_r:In 1"
                    }
                    {
                        output = "spatial_copy_l:Out"
                        input = "spatial_delay_l:In"
                    }
                    {
                        output = "spatial_copy_r:Out"
                        input = "spatial_delay_r:In"
                    }
                    {
                        output = "spatial_delay_l:Out"
                        input = "spatial_lp_l:In"
                    }
                    {
                        output = "spatial_delay_r:Out"
                        input = "spatial_lp_r:In"
                    }
                    {
                        output = "spatial_lp_l:Out"
                        input = "spatial_mix_r:In 2"
                    }
                    {
                        output = "spatial_lp_r:Out"
                        input = "spatial_mix_l:In 2"
                    }
                    {
                        output = "spatial_mix_l:Out"
