# Sonar — PipeWire graf yapılandırması
#
# BU DOSYA OTOMATİK ÜRETİLİR. Elle yapılan değişiklikler bir sonraki yeniden inşada
# kaybolur; kalıcı değişiklik için ~/.config/sonar/config.toml dosyasını düzenleyin.
#
# Çalıştırma:  pipewire -c <bu dosya>

context.properties = {
    log.level = 2
    default.clock.rate = 48000
    default.clock.allowed-rates = [ 48000 ]
}
context.spa-libs = {
    audio.convert.* = "audioconvert/libspa-audioconvert"
    support.* = "support/libspa-support"
}
context.modules = [
    {
        name = "libpipewire-module-rt"
        args = {
            nice.level = -11
            rt.prio = 88
        }
        flags = [ "ifexists" "nofail" ]
    }
    {
        name = "libpipewire-module-protocol-native"
    }
    {
        name = "libpipewire-module-client-node"
    }
    {
        name = "libpipewire-module-adapter"
    }
    {
        name = "libpipewire-module-filter-chain"
        args = {
            node.description = "Sonar Game"
            media.name = "Sonar Game"
            filter.graph = {
                nodes = [
                    {
                        type = "lv2"
                        name = "gate"
                        plugin = "http://lsp-plug.in/plugins/lv2/gate_stereo"
                        control = {
                            enabled = 0.0
                        }
                    }
                    {
                        type = "lv2"
                        name = "eq"
                        plugin = "http://lsp-plug.in/plugins/lv2/para_equalizer_x32_stereo"
                        control = {
                            enabled = 0.0
                            ife_l = 0.0
                            ife_r = 0.0
                            ofe_l = 0.0
                            ofe_r = 0.0
                            rfe_l = 0.0
                            rfe_r = 0.0
                        }
                    }
                    {
                        type = "lv2"
                        name = "comp"
                        plugin = "http://lsp-plug.in/plugins/lv2/compressor_stereo"
                        control = {
                            enabled = 0.0
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_copy_l"
                        label = "copy"
                    }
                    {
                        type = "builtin"
                        name = "spatial_copy_r"
                        label = "copy"
                    }
                    {
                        type = "builtin"
                        name = "spatial_delay_l"
                        label = "delay"
                        control = {
                            "Delay (s)" = 0.0
                        }
                        config = {
                            max-delay = 0.01
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_delay_r"
                        label = "delay"
                        control = {
                            "Delay (s)" = 0.0
                        }
                        config = {
                            max-delay = 0.01
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_lp_l"
                        label = "bq_lowpass"
                        control = {
                            Freq = 1000.0
                            Q = 0.707
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_lp_r"
                        label = "bq_lowpass"
                        control = {
                            Freq = 1000.0
                            Q = 0.707
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_mix_l"
                        label = "mixer"
                        control = {
                            "Gain 1" = 1.0
                            "Gain 2" = 0.0
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_mix_r"
                        label = "mixer"
                        control = {
                            "Gain 1" = 1.0
                            "Gain 2" = 0.0
                        }
                    }
                    {
                        type = "builtin"
                        name = "boost_l"
                        label = "linear"
                        control = {
                            Mult = 1.0
                            Add = 0.0
                        }
                    }
                    {
                        type = "builtin"
                        name = "boost_r"
                        label = "linear"
                        control = {
                            Mult = 1.0
                            Add = 0.0
                        }
                    }
                    {
                        type = "lv2"
                        name = "lim"
                        plugin = "http://lsp-plug.in/plugins/lv2/limiter_stereo"
                        control = {
                            enabled = 0.0
                        }
                    }
                ]
                inputs = [ "gate:in_l" "gate:in_r" ]
                outputs = [ "lim:out_l" "lim:out_r" ]
                links = [
                    {
                        output = "gate:out_l"
                        input = "eq:in_l"
                    }
                    {
                        output = "gate:out_r"
                        input = "eq:in_r"
                    }
                    {
                        output = "eq:out_l"
                        input = "comp:in_l"
                    }
                    {
                        output = "eq:out_r"
                        input = "comp:in_r"
                    }
                    {
                        output = "comp:out_l"
                        input = "spatial_copy_l:In"
                    }
                    {
                        output = "comp:out_r"
                        input = "spatial_copy_r:In"
                    }
                    {
                        output = "spatial_copy_l:Out"
                        input = "spatial_mix_l:In 1"
                    }
                    {
                        output = "spatial_copy_r:Out"
                        input = "spatial_mix_r:In 1"
                    }
                    {
                        output = "spatial_copy_l:Out"
                        input = "spatial_delay_l:In"
                    }
                    {
                        output = "spatial_copy_r:Out"
                        input = "spatial_delay_r:In"
                    }
                    {
                        output = "spatial_delay_l:Out"
                        input = "spatial_lp_l:In"
                    }
                    {
                        output = "spatial_delay_r:Out"
                        input = "spatial_lp_r:In"
                    }
                    {
                        output = "spatial_lp_l:Out"
                        input = "spatial_mix_r:In 2"
                    }
                    {
                        output = "spatial_lp_r:Out"
                        input = "spatial_mix_l:In 2"
                    }
                    {
                        output = "spatial_mix_l:Out"
                        input = "boost_l:In"
                    }
                    {
                        output = "spatial_mix_r:Out"
                        input = "boost_r:In"
                    }
                    {
                        output = "boost_l:Out"
                        input = "lim:in_l"
                    }
                    {
                        output = "boost_r:Out"
                        input = "lim:in_r"
                    }
                ]
            }
            capture.props = {
                node.name = "sonar_game"
                node.description = "Sonar Game — Virtual Output"
                node.nick = "Game"
                media.class = "Audio/Sink"
                device.icon-name = "audio-card"
                priority.session = 0
                audio.rate = 48000
                audio.channels = 2
                audio.position = [ "FL" "FR" ]
            }
            playback.props = {
                node.name = "sonar_game_fx"
                node.autoconnect = false
                audio.rate = 48000
                audio.channels = 2
                audio.position = [ "FL" "FR" ]
                node.description = "Sonar Game FX"
            }
        }
    }
    {
        name = "libpipewire-module-filter-chain"
        args = {
            node.description = "Sonar Chat"
            media.name = "Sonar Chat"
            filter.graph = {
                nodes = [
                    {
                        type = "lv2"
                        name = "gate"
