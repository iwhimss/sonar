                        control = {
                            "Attenuation Limit (dB)" = 0.0
                        }
                    }
                    {
                        type = "lv2"
                        name = "gate"
                        plugin = "http://lsp-plug.in/plugins/lv2/gate_stereo"
                        control = {
                            enabled = 0.0
                        }
                    }
                    {
                        type = "lv2"
                        name = "eq"
                        plugin = "http://lsp-plug.in/plugins/lv2/para_equalizer_x32_stereo"
                        control = {
                            enabled = 0.0
                            ife_l = 0.0
                            ife_r = 0.0
                            ofe_l = 0.0
                            ofe_r = 0.0
                            rfe_l = 0.0
                            rfe_r = 0.0
                        }
                    }
                    {
                        type = "lv2"
                        name = "comp"
                        plugin = "http://lsp-plug.in/plugins/lv2/compressor_stereo"
                        control = {
                            enabled = 0.0
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_copy_l"
                        label = "copy"
                    }
                    {
                        type = "builtin"
                        name = "spatial_copy_r"
                        label = "copy"
                    }
                    {
                        type = "builtin"
                        name = "spatial_delay_l"
                        label = "delay"
                        control = {
                            "Delay (s)" = 0.0
                        }
                        config = {
                            max-delay = 0.01
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_delay_r"
                        label = "delay"
                        control = {
                            "Delay (s)" = 0.0
                        }
                        config = {
                            max-delay = 0.01
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_lp_l"
                        label = "bq_lowpass"
                        control = {
                            Freq = 1000.0
                            Q = 0.707
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_lp_r"
                        label = "bq_lowpass"
                        control = {
                            Freq = 1000.0
                            Q = 0.707
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_mix_l"
                        label = "mixer"
                        control = {
                            "Gain 1" = 1.0
                            "Gain 2" = 0.0
                        }
                    }
                    {
                        type = "builtin"
                        name = "spatial_mix_r"
                        label = "mixer"
                        control = {
                            "Gain 1" = 1.0
                            "Gain 2" = 0.0
                        }
                    }
                    {
                        type = "builtin"
                        name = "boost_l"
                        label = "linear"
                        control = {
                            Mult = 1.0
                            Add = 0.0
                        }
                    }
                    {
                        type = "builtin"
                        name = "boost_r"
                        label = "linear"
                        control = {
                            Mult = 1.0
                            Add = 0.0
